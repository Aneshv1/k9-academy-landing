---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Awards from '../components/Awards.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
import GuideBanner from '../components/GuideBanner.astro';
import QuizForm from '../components/QuizForm.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';
import '../styles/global.css';
---

<Layout title="Puppy Training Classes Toronto. Start Early | K9 Academy" description="Puppy training classes in Toronto. Build the foundation before bad habits form. Socialization, crate training, and basic obedience for puppies under 1 year.">
  <Navbar />

  <!-- HERO -->
  <section class="relative pt-28 sm:pt-36 pb-14 sm:pb-20 overflow-hidden bg-brand-dark">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-center mb-8">
        <div class="inline-flex items-center gap-2.5 bg-white/5 backdrop-blur-sm rounded-full px-4 py-2 border border-white/10">
          <svg class="w-4 h-4 flex-shrink-0" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
          <div class="flex items-center gap-0.5">
            {[1,2,3,4,5].map(() => (
              <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <span class="text-sm font-semibold text-white">4.9/5</span>
          <span class="w-px h-4 bg-white/20"></span>
          <span class="text-sm text-neutral-400">250+ Google Reviews</span>
        </div>
      </div>

      <div class="text-center max-w-4xl mx-auto">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.08]">
          A puppy class where they
          <br />
          <span class="bg-gradient-to-r from-k9-orange to-amber-400 bg-clip-text text-transparent">actually learn</span>
        </h1>

        <div class="mt-6 inline-flex items-center gap-2.5 bg-white/5 border border-white/10 rounded-full px-4 py-2">
          <span class="text-sm text-neutral-300 italic">"Finally a puppy class worth going to."</span>
        </div>

        <p class="mt-5 text-lg sm:text-xl text-neutral-400 max-w-2xl mx-auto leading-relaxed">
          Most puppy classes are glorified playtime. Ours is focused on raising a properly behaved adult dog. Real commands, controlled socialization, bite inhibition that actually works, and house manners. that stick for life. Four sessions, under 5.5 months.
        </p>

        <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="#contact" class="inline-flex items-center px-8 py-4 bg-k9-orange text-white text-base font-bold rounded-xl hover:bg-k9-orange-dark transition-all shadow-lg shadow-k9-orange/30 hover:shadow-xl hover:-translate-y-0.5">
            Get on the Waitlist
            <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
          <a href="tel:4377785273" class="inline-flex items-center gap-2 text-neutral-400 font-medium hover:text-white transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
            Or call 437-778-5273
          </a>
        </div>

        <div class="mt-8 flex flex-wrap justify-center gap-x-6 gap-y-2">
          {['For puppies under 5.5 months', '4 one-hour sessions', 'Handbook + materials included', 'Spots are limited'].map((item) => (
            <div class="flex items-center gap-1.5 text-sm text-neutral-500">
              <svg class="w-4 h-4 text-k9-orange flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span>{item}</span>
            </div>
          ))}
        </div>

        <!-- Hero Video -->
        <div class="mt-10 max-w-3xl mx-auto rounded-2xl overflow-hidden border border-white/10 shadow-2xl shadow-black/50">
          <YouTubeEmbed videoId="44swSqb9woU" title="K9 Academy Puppy Training" />
        </div>
      </div>
    </div>
  </section>

  <Awards />

  <!-- OLDER DOG REDIRECT -->
  <section class="bg-neutral-50 border-b border-neutral-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-3">
        <p class="text-sm text-neutral-700"><strong>Dog older than 6 months?</strong> Our Obedience Classes (Beginner + Advanced) are a better fit.</p>
        <a href="/group-classes" class="inline-flex items-center px-4 py-2 text-sm font-semibold text-k9-orange border border-k9-orange/30 rounded-lg hover:bg-k9-orange hover:text-white transition-all whitespace-nowrap">
          View Obedience Classes
          <svg class="ml-1.5 w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- PAS -->
  <section class="py-16 sm:py-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <p class="text-k9-orange font-semibold text-sm tracking-wide uppercase mb-3">The clock is ticking</p>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-neutral-900 leading-tight">
          The socialization window closes at 16 weeks.<br/>After that, everything gets harder.
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-5 mb-10">
        {[
          {
            pain: 'Bad habits are forming now',
            detail: 'Nipping, jumping, ignoring commands. Every day without structure, these get stronger and harder to fix.',
            iconPath: 'M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z',
          },
          {
            pain: 'YouTube is making it worse',
            detail: 'Conflicting tips, outdated methods, no system. You\'re trying everything and nothing sticks.',
            iconPath: 'M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636',
          },
          {
            pain: 'The window is closing',
            detail: 'Socialization, confidence, bite inhibition. Miss the first 16 weeks and you spend years fixing what 4 sessions could have prevented.',
            iconPath: 'M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z',
          },
        ].map((item) => (
          <div class="rounded-2xl bg-neutral-50 border border-neutral-200 p-6 text-center hover:border-red-200 hover:bg-red-50/30 transition-all group">
            <div class="w-12 h-12 rounded-full bg-red-50 border border-red-100 flex items-center justify-center mx-auto mb-4 group-hover:bg-red-100 transition-colors">
              <svg class="w-6 h-6 text-red-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d={item.iconPath} />
              </svg>
            </div>
            <h3 class="text-lg font-extrabold text-neutral-900 mb-2">{item.pain}</h3>
            <p class="text-neutral-500 text-sm leading-relaxed">{item.detail}</p>
          </div>
        ))}
      </div>

      <!-- Urgency -->
      <div class="rounded-2xl bg-neutral-900 p-6 text-center mb-10">
        <p class="text-white font-bold text-lg mb-1">Your puppy's critical window is open right now.</p>
        <p class="text-neutral-400 text-sm">4 sessions. That's all it takes to set the foundation for a lifetime.</p>
      </div>

      <!-- Quote -->
      <div class="rounded-2xl bg-neutral-50 border border-neutral-200 p-6 sm:p-8 mb-10">
        <div class="flex items-center gap-0.5 mb-3">
          {[1,2,3,4,5].map(() => (
            <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          ))}
        </div>
        <blockquote class="text-lg font-semibold text-neutral-900 leading-relaxed mb-3">
          "By 5 months old our puppy was better behaved than most adult dogs we see at the park. Best thing we did as new dog owners."
        </blockquote>
        <p class="text-neutral-400 text-sm">Priya S. · Lab mix, started at 12 weeks · Foundation Program</p>
      </div>

      <!-- CTA -->
      <div class="text-center">
        <a href="#contact" class="inline-flex items-center px-8 py-4 bg-k9-orange text-white text-base font-bold rounded-xl hover:bg-k9-orange-dark transition-all shadow-lg shadow-k9-orange/30 hover:shadow-xl hover:-translate-y-0.5">
          Get on the Puppy Waitlist
          <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
        <p class="text-neutral-400 text-xs mt-3">Classes fill fast. Under 5.5 months only.</p>
      </div>
    </div>
  </section>

  <!-- WHAT YOUR PUPPY WILL LEARN -->
  <section class="py-16 sm:py-24 bg-neutral-50 border-y border-neutral-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 sm:mb-16">
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-k9-orange/10 rounded-full mb-4">
          <span class="w-2.5 h-2.5 rounded-full bg-k9-orange animate-pulse"></span>
          <span class="text-k9-orange font-bold text-sm uppercase tracking-wide">Real Curriculum, Real Results</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-neutral-900 leading-tight">
          What your puppy will actually learn
        </h2>
        <p class="mt-4 text-lg text-neutral-500 max-w-2xl mx-auto">
          This isn't a puppy playgroup with treats. Every session follows a structured curriculum designed to build real skills during your puppy's most critical development window.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-4 mb-12">
        {[
          { skill: 'Controlled socialization', note: 'Your puppy plays with dogs of all types. It\'s controlled — if there are issues, we fix them on the spot. Not a free-for-all.' },
          { skill: 'Biting and nipping — actually fixed', note: 'We show you how to stop it for real. Not the reinforcement-based methods other places teach that usually make it worse.' },
          { skill: 'Sit, down, place, and come commands', note: 'Commands that work outside, not just indoors with a treat in your hand. Real obedience from session one.' },
          { skill: 'Leash walking fundamentals', note: 'Loose-leash habits built from day one. No pulling, no lunging, no dragging you down the street.' },
          { skill: 'Crate + potty training protocol', note: 'A clear system that actually works. No more guessing or cleaning up accidents at 2 AM.' },
          { skill: 'Recall foundation', note: 'Your puppy comes when called. The skill that keeps them safe for life starts here.' },
          { skill: 'Impulse control + focus', note: 'Your puppy learns to think before reacting. Sit before eating, wait at doors, settle on command.' },
          { skill: 'Confidence building', note: 'Novel surfaces, obstacles, and agility intro. A confident puppy is a well-behaved puppy.' },
        ].map((item) => (
          <div class="flex items-start gap-3 p-4 bg-white rounded-xl border border-neutral-100">
            <div class="w-6 h-6 rounded-full bg-k9-orange/15 flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg class="w-3.5 h-3.5 text-k9-orange" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
            </div>
            <div>
              <p class="font-semibold text-neutral-900 text-sm">{item.skill}</p>
              <p class="text-neutral-500 text-sm mt-0.5">{item.note}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="text-center">
        <a href="#contact" class="inline-flex items-center px-7 py-4 bg-k9-orange text-white text-base font-bold rounded-xl hover:bg-k9-orange-dark transition-all shadow-lg shadow-k9-orange/30 hover:shadow-xl hover:-translate-y-0.5">
          Get on the Puppy Waitlist
          <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
        <p class="mt-3 text-sm text-neutral-400">All of this in just 4 sessions. Under 5.5 months only.</p>
      </div>
    </div>
  </section>

  <!-- COMPARISON CHART -->
  <section class="py-16 sm:py-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8">
        <h3 class="text-2xl sm:text-3xl font-extrabold text-neutral-900">Not all puppy classes are created equal</h3>
        <p class="mt-2 text-neutral-500 max-w-xl mx-auto text-sm">Most puppy classes are glorified playtime. We're building properly behaved adult dogs.</p>
      </div>

      <div class="overflow-x-auto -mx-4 px-4 sm:mx-0 sm:px-0">
        <table class="w-full border-collapse text-sm">
          <thead>
            <tr>
              <th class="text-left p-3 sm:p-4 text-neutral-500 font-medium text-xs uppercase tracking-wide"></th>
              <th class="p-3 sm:p-4 text-center rounded-t-xl bg-k9-orange text-white font-bold text-xs uppercase tracking-wide">K9 Academy</th>
              <th class="p-3 sm:p-4 text-center text-neutral-500 font-medium text-xs uppercase tracking-wide bg-neutral-50">Other Puppy Classes</th>
            </tr>
          </thead>
          <tbody>
            {[
              { feature: 'Structured curriculum', k9: true, other: false, highlight: false },
              { feature: 'Commands that work outside', k9: 'Every session', other: 'Only with treats indoors', highlight: false },
              { feature: 'Controlled socialization', k9: 'With any dog, issues fixed live', other: 'Unstructured free play', highlight: false },
              { feature: 'Biting + nipping fixed', k9: 'Actual fix, not management', other: 'Methods that make it worse', highlight: true },
              { feature: 'Leash walking fundamentals', k9: true, other: false, highlight: false },
              { feature: 'Extensive take-home handbook', k9: true, other: false, highlight: false },
              { feature: 'Trainer experience', k9: 'Most experienced in Ontario', other: 'Varies widely', highlight: false },
              { feature: 'Certificate of completion', k9: true, other: false, highlight: false },
              { feature: 'Bridge to full obedience', k9: 'Beginner Program', other: false, highlight: false },
              { feature: 'Focus on raising adult dogs', k9: 'Yes, that\'s the whole point', other: 'Puppy playtime', highlight: true },
              { feature: 'Results from session 1', k9: 'Yes, every time', other: 'Rarely', highlight: true },
            ].map((row, i) => (
              <tr class={row.highlight ? 'bg-k9-orange/10 border-t-2 border-k9-orange/30' : i % 2 === 0 ? 'bg-white' : 'bg-neutral-50/50'}>
                <td class={`p-3 sm:p-4 text-sm whitespace-nowrap ${row.highlight ? 'font-extrabold text-neutral-900' : 'font-medium text-neutral-900'}`}>{row.feature}</td>
                <td class={`p-3 sm:p-4 text-center font-semibold ${row.highlight ? 'bg-k9-orange/15' : 'bg-k9-orange/5'} text-neutral-900`}>
                  {row.k9 === true ? (
                    <svg class="w-5 h-5 text-k9-orange mx-auto" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                  ) : typeof row.k9 === 'string' ? (
                    <span class={`font-bold ${row.highlight ? 'text-k9-orange text-base' : 'text-k9-orange'}`}>{row.k9}</span>
                  ) : (
                    <svg class="w-5 h-5 text-neutral-300 mx-auto" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                  )}
                </td>
                <td class={`p-3 sm:p-4 text-center ${row.highlight ? 'text-red-400 font-semibold' : 'text-neutral-500'}`}>
                  {row.other === true ? (
                    <svg class="w-5 h-5 text-emerald-500 mx-auto" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                  ) : row.other === false ? (
                    <svg class="w-5 h-5 text-neutral-300 mx-auto" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                  ) : (
                    <span>{row.other}</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="py-16 sm:py-24 bg-neutral-50 border-y border-neutral-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="text-k9-orange font-semibold text-sm tracking-wide uppercase mb-3">What Puppy Owners Say</p>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-neutral-900">
          The best investment you can make in your puppy
        </h2>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {[
          { headline: 'Best thing we did as new dog owners', text: 'We had no idea what we were doing with our first puppy. K9 Academy gave us the structure and confidence we needed. By 5 months old our puppy was better behaved than most adult dogs we see at the park.', name: 'Priya S.', detail: 'Lab mix, started at 12 weeks · Foundation Program' },
          { headline: 'Wish we started even sooner', text: 'We waited until our puppy was 4 months and already had some nipping issues. Within two weeks of the Puppy Class, the biting stopped completely. The socialization alone was worth the entire price.', name: 'Alex & Jen M.', detail: 'Golden Retriever, 4 months · Puppy Class' },
          { headline: 'Our vet noticed the difference', text: 'At our last vet visit, they actually commented on how well-behaved our puppy was compared to most dogs they see. That is all from K9 Academy. The Foundation Program set him up for life.', name: 'Marcus T.', detail: 'Bernese Mountain Dog, 14 weeks · Foundation Program' },
        ].map((t) => (
          <div class="bg-white rounded-2xl p-6 border border-neutral-200/60 flex flex-col">
            <div class="flex items-center gap-2 mb-4">
              <svg class="w-5 h-5" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" />
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" />
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" />
              </svg>
              <div class="flex items-center gap-0.5">
                {[1,2,3,4,5].map(() => (
                  <svg class="w-3.5 h-3.5 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
